# Optional. Defaults to ~/.local/share/nixhost
NIXHOST_DATA_DIR=

# Dashboard listener
HOSTNAME=0.0.0.0
PORT=3000

# Recommended for portable backups. When omitted, NixHost generates a local mode-0600 key file.
# Generate with: openssl rand -base64 32
NIXHOST_MASTER_KEY=

# Optional externally reachable base URL used for GitHub App callbacks/webhooks.
# LAN URL is detected from the browser when omitted; webhooks require a public URL.
NIXHOST_PUBLIC_URL=

# Optional distributor integration. Register this exact callback URI on a
# public Cloudflare OAuth client using Authorization Code + PKCE and no client secret.
NIXHOST_CLOUDFLARE_OAUTH_CLIENT_ID=
NIXHOST_CLOUDFLARE_OAUTH_REDIRECT_URI=
NIXHOST_CLOUDFLARE_OAUTH_SCOPES=

# Runtime controls
NIXHOST_BUILD_CONCURRENCY=1
NIXHOST_GIT_POLL_SECONDS=60
NIXHOST_METRICS_SECONDS=5
NIXHOST_MIN_FREE_DISK_MB=1024
NIXHOST_MIN_FREE_MEMORY_MB=256
NIXHOST_RELEASE_RETENTION=5
NIXHOST_LOG_RETENTION_DAYS=7
NIXHOST_LOG_MAX_MB=1024
NIXHOST_LOG_LEVEL=info
