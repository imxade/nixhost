# Optional. Defaults to ~/.local/share/nixhost
NIXHOST_DATA_DIR=

# Dashboard listener
HOSTNAME=0.0.0.0
PORT=3000

# Recommended for portable backups. When omitted, NixHost generates a local mode-0600 key file.
# Generate with: openssl rand -base64 32
NIXHOST_MASTER_KEY=

# Optional stable public dashboard origin. Custom Cloudflare dashboard domains take
# priority; otherwise the supervised Quick Tunnel URL is used for GitHub webhooks.
NIXHOST_PUBLIC_URL=

# cloudflared executable name or absolute path.
NIXHOST_CLOUDFLARED_BIN=cloudflared

# Account-free temporary public URLs for the dashboard and every web app.
# Each URL remains while NixHost and its cloudflared process keep running, but can
# change after shutdown, reboot, crash, or process recreation. Disable globally for
# private-only nodes.
NIXHOST_QUICK_TUNNELS_ENABLED=true
NIXHOST_QUICK_TUNNEL_RECONCILE_SECONDS=10

# Optional distributor integration. Register this exact callback URI on a
# public Cloudflare OAuth client using Authorization Code + PKCE and no client secret.
NIXHOST_CLOUDFLARE_OAUTH_ENABLED=false
NIXHOST_CLOUDFLARE_OAUTH_CLIENT_ID=
NIXHOST_CLOUDFLARE_OAUTH_REDIRECT_URI=
NIXHOST_CLOUDFLARE_OAUTH_SCOPES=

# Runtime controls
NIXHOST_BUILD_CONCURRENCY=1
NIXHOST_GIT_POLL_SECONDS=60
NIXHOST_METRICS_SECONDS=5
NIXHOST_MIN_FREE_DISK_MB=1024
NIXHOST_MIN_FREE_MEMORY_MB=256
NIXHOST_RELEASE_RETENTION=5
NIXHOST_LOG_RETENTION_DAYS=7
NIXHOST_LOG_MAX_MB=1024
NIXHOST_LOG_LEVEL=info
